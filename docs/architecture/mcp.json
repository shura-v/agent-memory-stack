  "cards": [
    {
      "dot": "cyan",
      "title": "Upstream tool contract",
      "items": [
        "Tool names, schemas and results come from unchanged TDAI stdio.",
        "AMS connects official SDK transports without a private HTTP server."
      ]
    },
    {
      "dot": "rose",
      "title": "Checks before execution",
      "items": [
        "Every HTTP POST checks the active user before starting TDAI.",
        "Access checks resource permissions and adds the service header."
      ]
    },
    {
      "dot": "violet",
      "title": "Request lifecycle",
      "items": [
        "Each POST starts its own stock stdio process with the caller key.",
        "Response completion or disconnect closes the child. No persistent sessions."
      ]
    }
  ]
