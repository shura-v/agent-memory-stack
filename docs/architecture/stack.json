  "cards": [
    {
      "dot": "cyan",
      "title": "Two independent connections",
      "items": [
        "MemoryProxy supplies the agent's model API with memory.",
        "MCP exposes Knowledge tools; it is not the model endpoint."
      ]
    },
    {
      "dot": "emerald",
      "title": "One machine or a VPS",
      "items": [
        "Default ports bind only to localhost; setup can choose free ports.",
        "Locally use localhost. Remotely use your own Caddy with paths preserved."
      ]
    },
    {
      "dot": "violet",
      "title": "Management and deployment",
      "items": [
        "Panel also manages Knowledge through knowledge-service.",
        "AMS prepares Compose, images and keys; Core and Knowledge have separate model selections."
      ]
    }
  ]
