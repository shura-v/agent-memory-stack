# Create through ams → Configure stack. Double-quoted values use JSON escaping.
# Compose receives a separate secret-free env; do not pass this file to Compose.
# AMS always deploys Core, Knowledge, Panel, MemoryProxy, CLIProxyAPI and MCP together.
# Panel, MemoryProxy, and MCP publish to 127.0.0.1 by default.
# Other interfaces require explicit opt-in below. Ports are preferences; apply resolves conflicts.
# Direct Knowledge HTTP tools are optional; the internal gateway remains available to MCP.
CORE_SERVICE_ENABLED="false"
CLIPROXY_SERVICE_ENABLED="false"
KNOWLEDGE_SERVICE_ENABLED="false"
KNOWLEDGE_TOOLS_PUBLIC_ENABLED="false"
CORE_SERVICE_PORT="8420"
CLIPROXY_SERVICE_PORT="8317"
KNOWLEDGE_SERVICE_PORT="8423"
MEMORY_PROXY_PORT="8096"
KNOWLEDGE_PORT="8422"
PANEL_PORT="8123"
MCP_PORT="8425"
MEMORY_PROXY_PUBLIC_URL="http://127.0.0.1:8096"
KNOWLEDGE_PUBLIC_URL="http://127.0.0.1:8422"
PANEL_PUBLIC_URL="http://127.0.0.1:8123"
DATA_DIR="./data"
# Fresh eligible setup selects cliproxy; absent metadata preserves existing external routing.
# cliproxy uses http://cli-proxy-api:8317/v1 and the current CLIPROXY_API_KEY automatically.
# It requires local CLIProxyAPI and shares account capacity with agent requests.
INTERNAL_LLM_SOURCE="external"
# Used only for external mode. Retained values are inactive in cliproxy mode.
LLM_BASE_URL=""
LLM_API_KEY=""
# Separate models for each consumer. In cliproxy mode, Apply asks for missing models after login.
MEMORY_LLM_MODEL=""
KNOWLEDGE_LLM_MODEL=""
# Setup reuses these local keys or generates missing ones automatically, without questions.
CORE_API_KEY=""
CLIPROXY_API_KEY=""
# Account to check/login during Apply; existing accounts for other providers are retained.
CLIPROXY_AUTH_PROVIDER="codex"
MEMORY_PROMPT_MODE="code"
LOG_LEVEL="error"
MEMORY_LLM_MAX_TOKENS="32000"
KNOWLEDGE_LLM_MAX_TOKENS="32768"
MEMORY_LLM_TIMEOUT_MS="300000"
KNOWLEDGE_LLM_TIMEOUT_MS="1200000"
